# Copy to .env.local. No secrets here: the page only needs to know where the two bot builds run.
BOT_BROKEN_URL=http://127.0.0.1:8003/chat
BOT_FIXED_URL=http://127.0.0.1:8004/chat
# "today" sent to the bot; the test orders are dated October 2026 (same as the eval harness)
DEMO_TODAY=2026-10-18
# Hosts the page is served from (anything else is refused)
ALLOWED_HOSTS=127.0.0.1:3300,localhost:3300
# Optional: key for mapping browser session ids. If empty, a random one is generated each time the server
# starts, which also resets the fixed bot's conversation memory for open chats.
SESSION_SECRET=
